prefix=/home/muliyanpo/NJU/Projects/HW_SMPL/tpc_c_cplusplus/lycium/usr/gflags/arm64-v8a
exec_prefix=${prefix}
bindir=${prefix}/bin
libdir=${prefix}/lib
includedir=${prefix}/include

Name: gflags
Version: 2.2.2
Description: A commandline flags library that allows for distributed flags.
URL: http://gflags.github.io/gflags
Requires:
Libs: -L${libdir} -lgflags
Libs.private: -lpthread 
Cflags: -I${includedir}
