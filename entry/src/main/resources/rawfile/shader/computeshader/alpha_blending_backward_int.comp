void main() {

    uint dispatchThreadID_x = gl_GlobalInvocationID.x;
    uint dispatchThreadID_y = gl_GlobalInvocationID.y;

    // float oldvalueX1 = 1.0;
    int W = int(_W);
    int H = int(_H);
    int gridDim_x = (W + BLOCK_X - 1) / BLOCK_X;

    // index of tile
    int tile_idx_x = int(dispatchThreadID_x) / BLOCK_X;
    int tile_idx_y = int(dispatchThreadID_y) / BLOCK_Y;
    int tile_idx = tile_idx_y * gridDim_x + tile_idx_x;

    // index of shared gaussian in a chunk
    int local_x = int(dispatchThreadID_x) % BLOCK_X;
    int local_y = int(dispatchThreadID_y) % BLOCK_Y;
    int item_idx = local_x + local_y * BLOCK_X;

    // pixel col and row in the image
    uvec2 p = uvec2(tile_idx_x * BLOCK_X + local_x, tile_idx_y * BLOCK_Y + local_y);

    bool withinBounds = p.x < W && p.y < H;
    // bool thread_active = withinBounds;

    // Process gaussians in a tile in Chunks.
    ivec2 gaussian_range = tile_range_array[tile_idx];
    int gaussian_num = gaussian_range.y - gaussian_range.x;
    int num_chunk = (gaussian_num + PIXELS_PER_TILE - 1) / PIXELS_PER_TILE;

    vec3 dL_duvd_reg;
    vec3 dL_dconic_reg;
    float dL_dopacity_reg;

    float final_trans = withinBounds ? final_T_array[t2i(p.y, p.x, W)] : 0.0;
    float trans = final_trans;
    int remain_gaussian_num = gaussian_num;
    int current_process_idx = gaussian_num;
    int last_involved = withinBounds ? ncontrib_array[t2i(p.y, p.x, W)] : 0;

    vec3 accum_feat_term = vec3(0.0);

    for (int i = 0; i < num_chunk; i++, remain_gaussian_num -= PIXELS_PER_TILE) {
        barrier();

        int num_loaded = i * PIXELS_PER_TILE + item_idx;
        if (gaussian_range.x + num_loaded < gaussian_range.y) {
            int gidx = sort_idx_array[gaussian_range.y - num_loaded - 1];
            shared_idx[item_idx] = gidx;
            shared_uvd[item_idx] = vec3(
                uvd_array[3 * gidx],
                uvd_array[3 * gidx + 1],
                uvd_array[3 * gidx + 2]
            );
            shared_invcov[item_idx] = vec3(
                conic_array[3 * gidx],
                conic_array[3 * gidx + 1],
                conic_array[3 * gidx + 2]
            );
            shared_opacity[item_idx] = opacity_array[gidx];
            shared_feature[item_idx] = vec3(
                feature_array[3 * gidx],
                feature_array[3 * gidx + 1],
                feature_array[3 * gidx + 2]
            );
        }
        barrier();

        int num_to_process = min(PIXELS_PER_TILE, remain_gaussian_num);


        for (int j = 0; j < num_to_process; j++) {

            uint valid = 1;

            current_process_idx--;
            if (current_process_idx >= last_involved) {
                continue;
            }

            vec2 vec = vec2(shared_uvd[j].x - float(p.x), shared_uvd[j].y - float(p.y));

            // squared Mahalanobis distance
            vec3 shared_invcov_reg = shared_invcov[j];
            float maha_distance = shared_invcov_reg.x * vec.x * vec.x
                                 + shared_invcov_reg.y * vec.x * vec.y * 2.0
                                 + shared_invcov_reg.z * vec.y * vec.y;

            float power = -0.5f * maha_distance;
            if (power > 0.0f) {
                continue;
            }

            float G = exp(power);
            float current_opacity = shared_opacity[j];
            float alpha = min(0.99f, current_opacity * G);
            if (alpha < 1.0f / 255.0f){
                continue;
            }

            float tmp = 1.0 / (1.0 - alpha);
            trans = trans * tmp;

            vec3 dL_dalpha = vec3(0.0);
            vec3 dL_dG = vec3(0.0);
            vec2 dG_dvec = vec2(
                -G * vec.x * shared_invcov_reg.x - G * vec.y * shared_invcov_reg.y,
                -G * vec.y * shared_invcov_reg.z - G * vec.x * shared_invcov_reg.y
            );

            dL_duvd_reg = vec3(0.0);
            dL_dconic_reg = vec3(0.0);
            dL_dopacity_reg = 0.0;

            // MTR
            // from feature_array
            vec3 current_feature = shared_feature[j];
            vec3 dL_drfeat_reg = vec3(
                dL_drfeat_array[t2i(0, p.y, p.x, H, W)],
                dL_drfeat_array[t2i(1, p.y, p.x, H, W)],
                dL_drfeat_array[t2i(2, p.y, p.x, H, W)]
            );
            dL_dalpha = (current_feature * trans - accum_feat_term * tmp) * dL_drfeat_reg;
            accum_feat_term += alpha * current_feature * trans;

            // from background_array
            vec3 bg = vec3(
                background_array[t2i(0, p.y, p.x, H, W)],
                background_array[t2i(1, p.y, p.x, H, W)],
                background_array[t2i(2, p.y, p.x, H, W)]
            );
            dL_dalpha -= bg * final_trans * tmp * dL_drfeat_reg;
            dL_dG = current_opacity * dL_dalpha;

            dL_duvd_reg.x += (dL_dG.x + dL_dG.y + dL_dG.z) * dG_dvec.x;
            dL_duvd_reg.y += (dL_dG.x + dL_dG.y + dL_dG.z) * dG_dvec.y;

            dL_dconic_reg.x += -0.5f * G * vec.x * vec.x * (dL_dG.x + dL_dG.y + dL_dG.z);
            dL_dconic_reg.y += -G * vec.x * vec.y * (dL_dG.x + dL_dG.y + dL_dG.z);
            dL_dconic_reg.z += -0.5f * G * vec.y * vec.y * (dL_dG.x + dL_dG.y + dL_dG.z);
            dL_dopacity_reg += G * (dL_dalpha.x + dL_dalpha.y + dL_dalpha.z);

            /////////////////////////////////

            dL_drfeat_reg = alpha * trans * dL_drfeat_reg;

            atomicAdd(dL_dfeature_array[shared_idx[j] * 3 + 0], int(dL_drfeat_reg.x * SCALE));
            atomicAdd(dL_dfeature_array[shared_idx[j] * 3 + 1], int(dL_drfeat_reg.y * SCALE));
            atomicAdd(dL_dfeature_array[shared_idx[j] * 3 + 2], int(dL_drfeat_reg.z * SCALE));

            atomicAdd(dL_dconic_array[shared_idx[j] * 3 + 0], int(dL_dconic_reg.x * SCALE));
            atomicAdd(dL_dconic_array[shared_idx[j] * 3 + 1], int(dL_dconic_reg.y * SCALE));
            atomicAdd(dL_dconic_array[shared_idx[j] * 3 + 2], int(dL_dconic_reg.z * SCALE));

            atomicAdd(dL_duvd_array[shared_idx[j] * 3 + 0], int(dL_duvd_reg.x * SCALE));
            atomicAdd(dL_duvd_array[shared_idx[j] * 3 + 1], int(dL_duvd_reg.y * SCALE));

            atomicAdd(dL_dopacity_array[shared_idx[j]], int(dL_dopacity_reg * SCALE));
        }
    }

    // Background updates
    // if (withinBounds) {
    //     dL_dbackground_array[t2i(0, p.y, p.x, H, W)] = final_trans * dL_drfeat_array[t2i(0, p.y, p.x, H, W)];
    //     dL_dbackground_array[t2i(1, p.y, p.x, H, W)] = final_trans * dL_drfeat_array[t2i(1, p.y, p.x, H, W)];
    //     dL_dbackground_array[t2i(2, p.y, p.x, H, W)] = final_trans * dL_drfeat_array[t2i(2, p.y, p.x, H, W)];
    // }
    
}

