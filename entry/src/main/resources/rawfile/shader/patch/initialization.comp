#version 450
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : enable
#include "utils.comp"

layout(binding = 0) uniform sampler2D images[];
layout(binding = 1) buffer SrcPairsBuffer { int srcPairs[]; };
layout(binding = 2) buffer CameraIntricsBuffer { float cameraIntrics[]; };
layout(binding = 3) buffer CameraRotBuffer { float cameraRots[]; };
layout(binding = 4) buffer CameraTransBuffer { float cameraTrans[]; };
layout(binding = 5) buffer DepthRangesBuffer { float depthRanges[]; };
layout(binding = 6) buffer PlaneHypothesesBuffer { vec4 planeHypotheses[]; };

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint srcCount;
    uint currentImage;

    // patch parameter
    uint patch_size;
    uint radius_increment;
    uint sigma_spatial;
    uint sigma_color;
} pc;

void GetCamera(uint camId, inout Camera stCamera)
{
    stCamera.K = vec4(
        cameraIntrics[camId * 4 + 0],
        cameraIntrics[camId * 4 + 1],
        cameraIntrics[camId * 4 + 2],
        cameraIntrics[camId * 4 + 3]);

    stCamera.R = float[9](
        cameraRots[camId * 9 + 0],
        cameraRots[camId * 9 + 1],
        cameraRots[camId * 9 + 2],
        cameraRots[camId * 9 + 3],
        cameraRots[camId * 9 + 4],
        cameraRots[camId * 9 + 5],
        cameraRots[camId * 9 + 6],
        cameraRots[camId * 9 + 7],
        cameraRots[camId * 9 + 8]);

    stCamera.t = vec3(
        cameraTrans[camId * 3 + 0],
        cameraTrans[camId * 3 + 1],
        cameraTrans[camId * 3 + 2]);
}

float ComputeBilateralNCC(sampler2D ref_image, Camera ref_camera, sampler2D src_image, Camera src_camera, ivec2 p, vec4 plane_hypothesis)
{
    const float cost_max = 2.0;
    int radius = int(pc.patch_size) / 2;

    float H[9];
    ComputeHomography(ref_camera, src_camera, plane_hypothesis, H);
    vec2 pt = ComputeCorrespondingPoint(H, p);
    if (pt.x >= float(pc.width) || pt.x < 0.0 || pt.y >= float(pc.height) || pt.y < 0.0) {
        return cost_max;
    }

    float cost = 0.0;
    {
        float sum_ref = 0.0;
        float sum_ref_ref = 0.0;
        float sum_src = 0.0;
        float sum_src_src = 0.0;
        float sum_ref_src = 0.0;
        float bilateral_weight_sum = 0.0;
        float ref_center_pix = texture(ref_image, (vec2(p) + 0.5) / vec2(pc.width, pc.height)).r;

        for (int i = -radius; i < radius + 1; i += int(pc.radius_increment)) {
            float sum_ref_row = 0.0;
            float sum_src_row = 0.0;
            float sum_ref_ref_row = 0.0;
            float sum_src_src_row = 0.0;
            float sum_ref_src_row = 0.0;
            float bilateral_weight_sum_row = 0.0;

            for (int j = -radius; j < radius + 1; j += int(pc.radius_increment)) {
                ivec2 ref_pt = ivec2(p.x + i, p.y + j);
                float ref_pix = texture(ref_image, (ref_pt + 0.5) / vec2(pc.width, pc.height)).r;

                vec2 src_pt = ComputeCorrespondingPoint(H, ref_pt);
                float src_pix = texture(src_image, (src_pt + 0.5) / vec2(pc.width, pc.height)).r;

                float weight = ComputeBilateralWeight(float(i), float(j), ref_pix, ref_center_pix, float(pc.sigma_spatial), float(pc.sigma_color));

                sum_ref_row += weight * ref_pix;
                sum_ref_ref_row += weight * ref_pix * ref_pix;
                sum_src_row += weight * src_pix;
                sum_src_src_row += weight * src_pix * src_pix;
                sum_ref_src_row += weight * ref_pix * src_pix;
                bilateral_weight_sum_row += weight;
            }

            sum_ref += sum_ref_row;
            sum_ref_ref += sum_ref_ref_row;
            sum_src += sum_src_row;
            sum_src_src += sum_src_src_row;
            sum_ref_src += sum_ref_src_row;
            bilateral_weight_sum += bilateral_weight_sum_row;
        }
        const float inv_bilateral_weight_sum = 1.0 / bilateral_weight_sum;
        sum_ref *= inv_bilateral_weight_sum;
        sum_ref_ref *= inv_bilateral_weight_sum;
        sum_src *= inv_bilateral_weight_sum;
        sum_src_src *= inv_bilateral_weight_sum;
        sum_ref_src *= inv_bilateral_weight_sum;

        const float var_ref = sum_ref_ref - sum_ref * sum_ref;
        const float var_src = sum_src_src - sum_src * sum_src;

        const float kMinVar = 1e-5;
        if (var_ref < kMinVar || var_src < kMinVar) {
            return cost = cost_max;
        } else {
            const float covar_src_ref = sum_ref_src - sum_ref * sum_src;
            const float var_ref_src = sqrt(var_ref * var_src);
            return cost = max(0.0, min(cost_max, 1.0 - covar_src_ref / var_ref_src));
        }
    }

    return cost;
}

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
void main() {
    ivec2 pt = ivec2(gl_GlobalInvocationID.xy);

    if (pt.x >= pc.width || pt.y >= pc.height) {
        return;
    }

    vec2 uv = (vec2(pt) + 0.5) / vec2(pc.width, pc.height);
    float color = texture(images[pc.currentImage], uv).r;

    Camera refCamera;
    GetCamera(pc.currentImage, refCamera);

    float depth_min = depthRanges[pc.currentImage*2+0];
    float depth_max = depthRanges[pc.currentImage*2+1];

    vec4 plane = GenerateRandomPlaneHypothesis(vec4(refCamera.K), pt, depth_min, depth_max, pc.currentImage);
    //planeHypotheses[pt.y * pc.width + pt.x] = plane;

    uint isrc = srcPairs[pc.currentImage*pc.srcCount + 0];
    color = texture(images[isrc], uv).r;
    Camera srcCamera;
    GetCamera(isrc, srcCamera);

    float ncc = ComputeBilateralNCC(images[pc.currentImage], refCamera, images[isrc], srcCamera, pt, plane);
    planeHypotheses[pt.y * pc.width + pt.x] = vec4(ncc, ncc, ncc, 1.0);
    //if (pt.x == 0) {
    //    planeHypotheses[pt.y * pc.width + pt.x] = vec4(refCamera.R[0], refCamera.R[1], refCamera.R[2], refCamera.R[3]);
    //} else if (pt.x == 1) {
    //    planeHypotheses[pt.y * pc.width + pt.x] = vec4(refCamera.R[4], refCamera.R[5], refCamera.R[6], refCamera.R[7]);
    //} else if (pt.x == 2) {
