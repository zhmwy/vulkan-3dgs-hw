#version 450
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : enable

struct STCamera {
    vec4 K;
    vec3 t;
    float R[9];
    float minDepth;
    float maxDepth;
};

layout(binding = 0) uniform sampler2D images[];
layout(binding = 1) buffer SrcPairsBuffer { int srcPairs[]; };
layout(binding = 2) buffer CamerasBuffer { STCamera camerasBuffer[]; };
layout(binding = 3) buffer PlaneHypothesesBuffer { vec4 planeHypotheses[]; };
layout(binding = 4) buffer CostsBuffer { float costs[]; };
layout(binding = 5) buffer SelectedViewsBuffer { float selectedViews[]; };

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint srcCount;
    uint refImage;

    // patch parameter
    uint patch_size;
    uint radius_increment;
    uint sigma_spatial;
    uint sigma_color;
    uint top_k;
} pc;

#include "utils.comp"

float ComputeMultiViewInitialCostandSelectedViews(
    ivec2 p,                 // 像素坐标
    vec4 plane_hypothesis,   // 平面假设
    out uint selected_views  // 输出选中的视图掩码
) {
    const float cost_max = 2.0;
    float cost_vector[32];
    float cost_vector_copy[32];
    int cost_count = 0;
    uint num_valid_views = 0;

    // 初始化成本数组
    for (int i = 0; i < 32; ++i) {
        cost_vector[i] = cost_max;
        cost_vector_copy[i] = cost_max;
    }

    // 计算所有视图的成本
    for (int i = 0; i < pc.srcCount; ++i) {

        uint isrc = srcPairs[pc.refImage*pc.srcCount + i];

        float c = ComputeBilateralNCC(
            pc.refImage, images[pc.refImage],
            isrc, images[isrc],
            p, plane_hypothesis
        );
        cost_vector[i - 1] = c;
        cost_vector_copy[i - 1] = c;
        cost_count++;
        if (c < cost_max) {
            num_valid_views++;
        }
    }

    // 排序成本数组
    sort_small(cost_vector, cost_count);
    selected_views = 0u; // 初始化为0

    // 计算前top_k的平均成本
    uint top_k = min(num_valid_views, pc.top_k);
    if (top_k > 0) {
        float cost = 0.0;
        for (int i = 0; i < top_k; ++i) {
            cost += cost_vector[i];
        }
        float cost_threshold = cost_vector[top_k - 1];

        // 设置选中的视图掩码
        for (int i = 0; i < pc.srcCount; ++i) {
            if (cost_vector_copy[i] <= cost_threshold) {
                setBit(selected_views, i);
            }
        }
        return cost / float(top_k);
    } else {
        return cost_max;
    }
}

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
void main() {
    ivec2 pt = ivec2(gl_GlobalInvocationID.xy);

    if (pt.x >= pc.width || pt.y >= pc.height) {
        return;
    }

    vec2 uv = (vec2(pt) + 0.5) / vec2(pc.width, pc.height);
    float color = texture(images[pc.refImage], uv).r;

    STCamera refCamera = camerasBuffer[pc.refImage];

    vec4 plane = GenerateRandomPlaneHypothesis(refCamera.K, pt, refCamera.minDepth, refCamera.maxDepth, pc.refImage);
    planeHypotheses[pt.y * pc.width + pt.x] = plane;

    uint isrc = srcPairs[pc.refImage*pc.srcCount + 0];
    color = texture(images[isrc], uv).r;

    uint selected_views;
    float cost = ComputeMultiViewInitialCostandSelectedViews(pt, plane, selected_views);
    costs[pt.y * pc.width + pt.x] = cost;
}

