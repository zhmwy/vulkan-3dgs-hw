
#define M_PI 3.14159265358979323846

// 随机数部分
uint mobileRand(uvec2 coord, uint frame) {
    uint seed = (coord.x * 1973u) ^ (coord.y * 9277u) + frame;
    seed ^= seed << 13u;
    seed ^= seed >> 17u;
    seed ^= seed << 5u;
    return seed;
}

float random(uvec2 coord, uint frame) {
    uvec2 offCoord = uvec2(197, 197);
    return (float(mobileRand(coord, frame)) * (1.0 / 4294967296.0) +
           float(mobileRand(coord+offCoord, frame)) * (1.0 / 4294967296.0)) / 2.0;
}

float rand(vec2 seed) {
    return fract(sin(dot(seed, vec2(12.9898, 78.233))) * 43758.5453);
}

// 3D坐标计算
vec3 Get3DPoint(vec4 cameraK, ivec2 p, float depth) {
    vec3 X;
    X.x = depth * (float(p.x) - cameraK.z) / cameraK.x;
    X.y = depth * (float(p.y) - cameraK.w) / cameraK.y;
    X.z = depth;
    return X;
}

vec4 GetViewDirection(vec4 cameraK, const ivec2 p, const float depth)
{
    vec3 X = Get3DPoint(cameraK, p, depth);
    float norm = sqrt(X[0] * X[0] + X[1] * X[1] + X[2] * X[2]);

    vec4 view_direction;
    view_direction.x = X[0] / norm;
    view_direction.y = X[1] / norm;
    view_direction.z = X[2] / norm;
    view_direction.w = 0.0;
    return view_direction;
}

void NormalizeVec3(inout vec4 vec)
{
    const float normSquared = vec.x * vec.x + vec.y * vec.y + vec.z * vec.z;
    const float inverse_sqrt = inversesqrt(normSquared);
    vec.xyz *= inverse_sqrt;
}

vec4 GenerateRandomNormal(vec4 cameraK, const ivec2 p, const float depth, uint currentImage)
{
    float q1 = 1.0;
    float q2 = 1.0;
    float s  = 2.0;

    uint idx = currentImage;
    while (s >= 1.0) {
        q1 = 2.0 * random(uvec2(p), idx) - 1.0;
        q2 = 2.0 * random(uvec2(p + ivec2(37, 17)), idx + 1u) - 1.0;
        s = q1 * q1 + q2 * q2;
        idx = idx + 1u;
    }

    idx = uint(float(random(uvec2(p + ivec2(113, 127)), currentImage)) * 32771.0);

    const float sq = sqrt(1.0 - s);
    vec4 normal;
    if (idx % 3u == 0u) {
        normal.x = 2.0 * q1 * sq;
        normal.y = 2.0 * q2 * sq;
        normal.z = 1.0 - 2.0 * s;
    }
    else if (idx % 3u == 1u) {
        normal.y = 2.0 * q1 * sq;
        normal.z = 2.0 * q2 * sq;
        normal.x = 1.0 - 2.0 * s;
    }
    else /* if (idx % 3u == 2u) */ {
        normal.z = 2.0 * q1 * sq;
        normal.x = 2.0 * q2 * sq;
        normal.y = 1.0 - 2.0 * s;
    }
    normal.w = 0.0;

    vec4 view_direction = GetViewDirection(cameraK, p, depth);
    float dot_product = normal.x * view_direction.x + normal.y * view_direction.y + normal.z * view_direction.z;
    if (dot_product > 0.0) {
        normal.x = -normal.x;
        normal.y = -normal.y;
        normal.z = -normal.z;
    }
    NormalizeVec3(normal);
    return normal;
}

float GetDistance2Origin(vec4 cameraK, ivec2 p, const float depth, const vec4 normal)
{
    vec3 X = Get3DPoint(cameraK, p, depth);
    return -(normal.x * X.x + normal.y * X.y + normal.z * X.z);
}

vec4 GenerateRandomPlaneHypothesis(vec4 cameraK, const ivec2 p, const float depth_min, const float depth_max, uint currentImage)
{
    float depth = random(uvec2(p), 1u) * (depth_max - depth_min) + depth_min;
    vec4 plane_hypothesis = GenerateRandomNormal(cameraK, p, depth, currentImage);
    plane_hypothesis.w = GetDistance2Origin(cameraK, p, depth, plane_hypothesis);

    return plane_hypothesis;
}

// Compute homography function in GLSL
void ComputeHomography(uint iref, uint isrc, vec4 plane_hypothesis, inout float H[9]) {
    STCamera ref_camera = camerasBuffer[iref];
    STCamera src_camera = camerasBuffer[isrc];

    // Compute camera centers
    vec3 ref_C = vec3(
        -(ref_camera.R[0] * ref_camera.t[0] + ref_camera.R[3] * ref_camera.t[1] + ref_camera.R[6] * ref_camera.t[2]),
        -(ref_camera.R[1] * ref_camera.t[0] + ref_camera.R[4] * ref_camera.t[1] + ref_camera.R[7] * ref_camera.t[2]),
        -(ref_camera.R[2] * ref_camera.t[0] + ref_camera.R[5] * ref_camera.t[1] + ref_camera.R[8] * ref_camera.t[2])
    );

    vec3 src_C = vec3(
        -(src_camera.R[0] * src_camera.t[0] + src_camera.R[3] * src_camera.t[1] + src_camera.R[6] * src_camera.t[2]),
        -(src_camera.R[1] * src_camera.t[0] + src_camera.R[4] * src_camera.t[1] + src_camera.R[7] * src_camera.t[2]),
        -(src_camera.R[2] * src_camera.t[0] + src_camera.R[5] * src_camera.t[1] + src_camera.R[8] * src_camera.t[2])
    );

    // Compute relative rotation
    float R_relative[9];
    R_relative[0] = src_camera.R[0] * ref_camera.R[0] + src_camera.R[1] * ref_camera.R[1] + src_camera.R[2] * ref_camera.R[2];
    R_relative[1] = src_camera.R[0] * ref_camera.R[3] + src_camera.R[1] * ref_camera.R[4] + src_camera.R[2] * ref_camera.R[5];
    R_relative[2] = src_camera.R[0] * ref_camera.R[6] + src_camera.R[1] * ref_camera.R[7] + src_camera.R[2] * ref_camera.R[8];
    R_relative[3] = src_camera.R[3] * ref_camera.R[0] + src_camera.R[4] * ref_camera.R[1] + src_camera.R[5] * ref_camera.R[2];
    R_relative[4] = src_camera.R[3] * ref_camera.R[3] + src_camera.R[4] * ref_camera.R[4] + src_camera.R[5] * ref_camera.R[5];
    R_relative[5] = src_camera.R[3] * ref_camera.R[6] + src_camera.R[4] * ref_camera.R[7] + src_camera.R[5] * ref_camera.R[8];
    R_relative[6] = src_camera.R[6] * ref_camera.R[0] + src_camera.R[7] * ref_camera.R[1] + src_camera.R[8] * ref_camera.R[2];
    R_relative[7] = src_camera.R[6] * ref_camera.R[3] + src_camera.R[7] * ref_camera.R[4] + src_camera.R[8] * ref_camera.R[5];
    R_relative[8] = src_camera.R[6] * ref_camera.R[6] + src_camera.R[7] * ref_camera.R[7] + src_camera.R[8] * ref_camera.R[8];

    // Compute relative translation
    vec3 C_relative = ref_C - src_C;
    vec3 t_relative = vec3(
        src_camera.R[0] * C_relative.x + src_camera.R[1] * C_relative.y + src_camera.R[2] * C_relative.z,
        src_camera.R[3] * C_relative.x + src_camera.R[4] * C_relative.y + src_camera.R[5] * C_relative.z,
        src_camera.R[6] * C_relative.x + src_camera.R[7] * C_relative.y + src_camera.R[8] * C_relative.z
    );

    // Compute homography components
    float n = plane_hypothesis.w;  // plane normal scale factor
    H[0] = R_relative[0] - t_relative.x * plane_hypothesis.x / n;
    H[1] = R_relative[1] - t_relative.x * plane_hypothesis.y / n;
    H[2] = R_relative[2] - t_relative.x * plane_hypothesis.z / n;
    H[3] = R_relative[3] - t_relative.y * plane_hypothesis.x / n;
    H[4] = R_relative[4] - t_relative.y * plane_hypothesis.y / n;
    H[5] = R_relative[5] - t_relative.y * plane_hypothesis.z / n;
    H[6] = R_relative[6] - t_relative.z * plane_hypothesis.x / n;
    H[7] = R_relative[7] - t_relative.z * plane_hypothesis.y / n;
    H[8] = R_relative[8] - t_relative.z * plane_hypothesis.z / n;

    // Apply intrinsic matrices
    float tmp[9];
    tmp[0] = H[0] / ref_camera.K[0];
    tmp[1] = H[1] / ref_camera.K[1];
    tmp[2] = -H[0] * ref_camera.K[2] / ref_camera.K[0] - H[1] * ref_camera.K[3] / ref_camera.K[1] + H[2];
    tmp[3] = H[3] / ref_camera.K[0];
    tmp[4] = H[4] / ref_camera.K[1];
    tmp[5] = -H[3] * ref_camera.K[2] / ref_camera.K[0] - H[4] * ref_camera.K[3] / ref_camera.K[1] + H[5];
    tmp[6] = H[6] / ref_camera.K[0];
    tmp[7] = H[7] / ref_camera.K[1];
    tmp[8] = -H[6] * ref_camera.K[2] / ref_camera.K[0] - H[7] * ref_camera.K[3] / ref_camera.K[1] + H[8];

    H[0] = src_camera.K[0] * tmp[0] + src_camera.K[2] * tmp[6];
    H[1] = src_camera.K[0] * tmp[1] + src_camera.K[2] * tmp[7];
    H[2] = src_camera.K[0] * tmp[2] + src_camera.K[2] * tmp[8];
    H[3] = src_camera.K[1] * tmp[3] + src_camera.K[3] * tmp[6];
    H[4] = src_camera.K[1] * tmp[4] + src_camera.K[3] * tmp[7];
    H[5] = src_camera.K[1] * tmp[5] + src_camera.K[3] * tmp[8];
    H[6] = tmp[6];
    H[7] = tmp[7];
    H[8] = tmp[8];
}

float ComputeBilateralWeight(float x_dist, float y_dist, float pix, float center_pix, float sigma_spatial, float sigma_color) {
    float spatial_dist = sqrt(x_dist * x_dist + y_dist * y_dist);
    float color_dist = abs(pix - center_pix);
    return exp(-spatial_dist / (2.0 * sigma_spatial * sigma_spatial) -
               color_dist / (2.0 * sigma_color * sigma_color));
}

vec2 ComputeCorrespondingPoint(const float H[9], const ivec2 p)
{
    vec3 pt;
    pt.x = H[0] * float(p.x) + H[1] * float(p.y) + H[2];
    pt.y = H[3] * float(p.x) + H[4] * float(p.y) + H[5];
    pt.z = H[6] * float(p.x) + H[7] * float(p.y) + H[8];
    return vec2(pt.x / pt.z, pt.y / pt.z);
}

float ComputeBilateralNCC(uint iref, sampler2D ref_image, uint isrc, sampler2D src_image, ivec2 p, vec4 plane_hypothesis)
{
    const float cost_max = 2.0;
    int radius = int(pc.patch_size) / 2;

    float H[9];
    ComputeHomography(iref, isrc, plane_hypothesis, H);
    vec2 pt = ComputeCorrespondingPoint(H, p);
    if (pt.x >= float(pc.width) || pt.x < 0.0 || pt.y >= float(pc.height) || pt.y < 0.0) {
        return cost_max;
    }

    float cost = 0.0;
    {
        float sum_ref = 0.0;
        float sum_ref_ref = 0.0;
        float sum_src = 0.0;
        float sum_src_src = 0.0;
        float sum_ref_src = 0.0;
        float bilateral_weight_sum = 0.0;
        float ref_center_pix = texture(ref_image, (vec2(p) + 0.5) / vec2(pc.width, pc.height)).r;

        for (int i = -radius; i < radius + 1; i += int(pc.radius_increment)) {
            float sum_ref_row = 0.0;
            float sum_src_row = 0.0;
            float sum_ref_ref_row = 0.0;
            float sum_src_src_row = 0.0;
            float sum_ref_src_row = 0.0;
            float bilateral_weight_sum_row = 0.0;

            for (int j = -radius; j < radius + 1; j += int(pc.radius_increment)) {
                ivec2 ref_pt = ivec2(p.x + i, p.y + j);
                float ref_pix = texture(ref_image, (ref_pt + 0.5) / vec2(pc.width, pc.height)).r;

                vec2 src_pt = ComputeCorrespondingPoint(H, ref_pt);
                float src_pix = texture(src_image, (src_pt + 0.5) / vec2(pc.width, pc.height)).r;

                float weight = ComputeBilateralWeight(float(i), float(j), ref_pix, ref_center_pix, float(pc.sigma_spatial), float(pc.sigma_color));

                sum_ref_row += weight * ref_pix;
                sum_ref_ref_row += weight * ref_pix * ref_pix;
                sum_src_row += weight * src_pix;
                sum_src_src_row += weight * src_pix * src_pix;
                sum_ref_src_row += weight * ref_pix * src_pix;
                bilateral_weight_sum_row += weight;
            }

            sum_ref += sum_ref_row;
            sum_ref_ref += sum_ref_ref_row;
            sum_src += sum_src_row;
            sum_src_src += sum_src_src_row;
            sum_ref_src += sum_ref_src_row;
            bilateral_weight_sum += bilateral_weight_sum_row;
        }
        const float inv_bilateral_weight_sum = 1.0 / bilateral_weight_sum;
        sum_ref *= inv_bilateral_weight_sum;
        sum_ref_ref *= inv_bilateral_weight_sum;
        sum_src *= inv_bilateral_weight_sum;
        sum_src_src *= inv_bilateral_weight_sum;
        sum_ref_src *= inv_bilateral_weight_sum;

        const float var_ref = sum_ref_ref - sum_ref * sum_ref;
        const float var_src = sum_src_src - sum_src * sum_src;

        const float kMinVar = 1e-5;
        if (var_ref < kMinVar || var_src < kMinVar) {
            return cost = cost_max;
        } else {
            const float covar_src_ref = sum_ref_src - sum_ref * sum_src;
            const float var_ref_src = sqrt(var_ref * var_src);
            return cost = max(0.0, min(cost_max, 1.0 - covar_src_ref / var_ref_src));
        }
    }

    return cost;
}

void setBit(inout uint flag, const uint n) {
    flag |= (1u << n);
}

uint isSet(uint flag, const uint n) {
    return (flag >> n) & 1u;
}

void sort_small(inout float d[32], const int n) {
    int j;
    for (int i = 1; i < n; i++) {
        float tmp = d[i];
        for (j = i; j >= 1 && tmp < d[j-1]; j--) {
            d[j] = d[j-1];
        }
        d[j] = tmp;
    }
}

void sort_small_weighted(inout float d[32], inout float w[32], int n) {
    int j;
    for (int i = 1; i < n; i++) {
        float tmp = d[i];
        float tmp_w = w[i];
        for (j = i; j >= 1 && tmp < d[j - 1]; j--) {
            d[j] = d[j - 1];
            w[j] = w[j - 1];
        }
        d[j] = tmp;
        w[j] = tmp_w;
    }
}

float ComputeDepthfromPlaneHypothesis(const STCamera camera, const vec4 plane_hypothesis, const ivec2 p)
{
    return -plane_hypothesis.w * camera.K[0] / ((p.x - camera.K[2]) * plane_hypothesis.x + (camera.K[0] / camera.K[1]) * (p.y - camera.K[3]) * plane_hypothesis.y + camera.K[0] * plane_hypothesis.z);
}

